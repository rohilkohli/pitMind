# Backend (FastAPI)
# Comma-separated list of allowed origins for CORS.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# SlowAPI rate limit for /api/v1/* endpoints.
RATE_LIMIT_PER_MINUTE=120

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# IBM Granite — pick ONE integration path (never commit real keys)

# Watsonx.ai (IBM Cloud) → From IBM Cloud Console → watsonx.ai project settings
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# HuggingFace Inference API → From HuggingFace account → API tokens
# Model: ibm-granite/granite-3.1-8b-instruct (or compatible OSS alternative)
HF_API_TOKEN=
HF_MODEL_ID=ibm-granite/granite-3.1-8b-instruct

# Replicate-hosted Granite-style model → From Replicate dashboard
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=replicate
REPLICATE_MODEL_NAME=llama-2-70b-chat

# Langflow — optional HTTP API for orchestrated pipeline
# From your Langflow deployment (API base URL + flow ID + API key)
LANGFLOW_API_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# Google Maps JavaScript API → From Google Cloud Console → Credentials
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Frontend API Configuration
VITE_API_BASE_URL=http://api:8000

# Frontend WebSocket Configuration
# WebSocket URL for real-time telemetry streaming
# Development: ws://localhost:8000/api/v1/stream/telemetry
# Production: wss://your-domain.com/api/v1/stream/telemetry
VITE_WS_URL=ws://localhost:8000/api/v1/stream/telemetry

# Frontend Development Settings
# Set to 'true' to bypass authentication in development mode only
# NEVER set this to 'true' in production builds
VITE_BYPASS_AUTH=false

# Firebase Realtime Database + Auth (frontend uses VITE_*)
# From Firebase Console → Project settings → Your apps (Web config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# From Firebase Console → Realtime Database → Data tab URL
VITE_FIREBASE_DATABASE_URL=
# Optional: use a lightweight API key for RTDB-only polling in fan telemetry
VITE_FIREBASE_WEB_API_KEY=

# Backend Firebase admin (optional for auth + server-side reads)
# From Firebase Console → Service accounts
FIREBASE_DATABASE_URL=
FIREBASE_WEB_API_KEY=

# Google Analytics Measurement ID → From Google Analytics property settings
VITE_GA_MEASUREMENT_ID=

# Monitoring & Logging (Production)
SENTRY_DSN=
DATADOG_API_KEY=

# Email Configuration (if implementing alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Session & Security
SESSION_SECRET=your_session_secret_key_here
JWT_SECRET=your_jwt_secret_key_here

# Redis Configuration
# Redis connection URL for caching and session management
# Format: redis://[username:password@]host:port/database
# Development: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# PostgreSQL Configuration
# PostgreSQL connection URL with asyncpg driver for async operations
# Format: postgresql+asyncpg://username:password@host:port/database
# Development: postgresql+asyncpg://pitmind:pitmind@localhost:5432/pitmind
# Docker: postgresql+asyncpg://pitmind:pitmind@postgres:5432/pitmind
DATABASE_URL=postgresql+asyncpg://pitmind:pitmind@localhost:5432/pitmind
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache Configuration
# Enable/disable caching layer (set to false to bypass cache for testing)
CACHE_ENABLED=true

# TTL (Time To Live) values in seconds
# Default TTL for generic cache entries (5 minutes)
CACHE_TTL_DEFAULT=300

# Strategy recommendation cache TTL (5 minutes)
# Short TTL ensures fresh recommendations during active race conditions
CACHE_TTL_STRATEGY=300

# Historical race data cache TTL (1 hour)
# Longer TTL for data that doesn't change frequently
CACHE_TTL_HISTORICAL=3600

# Post-race analysis cache TTL (24 hours)
# Very long TTL for completed race analysis
CACHE_TTL_POST_RACE=86400

# Session state cache TTL (1 hour)
CACHE_TTL_SESSION=3600

# Health metrics cache TTL (1 minute)
CACHE_TTL_HEALTH=60

# Maximum cache entries per session (prevents memory overflow)
CACHE_MAX_SIZE=1000

# Frontend
# Local Vite → FastAPI direct:
VITE_API_BASE_URL=http://localhost:8000
# Docker nginx `/api` proxy build uses empty string via compose build args.
