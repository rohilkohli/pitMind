# Backend (FastAPI)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=120

# IBM Granite — pick ONE integration path (never commit real keys)

# Watsonx.ai (IBM Cloud)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Or Replicate-hosted Granite-style model (example slug — set to your deployed Granite)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=
REPLICATE_MODEL_NAME=

# Langflow — optional HTTP API for orchestrated pipeline
LANGFLOW_API_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# Google — at least one recommended for demo (Maps shown in UI)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Realtime Database — optional live telemetry simulation (frontend uses VITE_*)
FIREBASE_DATABASE_URL=
FIREBASE_WEB_API_KEY=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_WEB_API_KEY=

# Google Analytics (Measurement ID for gtag in frontend)
VITE_GA_MEASUREMENT_ID=

# Frontend
# Local Vite → FastAPI direct:
VITE_API_BASE_URL=http://localhost:8000
# Docker nginx `/api` proxy build uses empty string via compose build args.
