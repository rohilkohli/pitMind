# ========================================
# PitMind Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to git

# ========================================
# Environment
# ========================================
ENVIRONMENT=development

# ========================================
# Backend Configuration
# ========================================
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=120

# ========================================
# IBM Watsonx.ai Configuration
# ========================================
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-project-id-here
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_MODEL_ID=ibm/granite-3-1-8b-instruct

# ========================================
# HuggingFace Configuration (Optional)
# ========================================
# Get your token from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your-huggingface-token-here
HF_MODEL_ID=ibm-granite/granite-3.1-8b-instruct

# ========================================
# Langflow Configuration (Optional)
# ========================================
LANGFLOW_API_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# ========================================
# Replicate Configuration (Optional)
# ========================================
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=replicate
REPLICATE_MODEL_NAME=llama-2-70b-chat

# ========================================
# Firebase Configuration
# ========================================
# Get your project ID from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id

# ========================================
# Redis Configuration
# ========================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ========================================
# PostgreSQL Database Configuration
# ========================================
DATABASE_URL=postgresql+asyncpg://pitmind:pitmind@localhost:5432/pitmind
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ========================================
# Cache Configuration
# ========================================
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=300
CACHE_TTL_STRATEGY=300
CACHE_TTL_HISTORICAL=3600
CACHE_TTL_POST_RACE=86400
CACHE_TTL_SESSION=3600
CACHE_TTL_HEALTH=60
CACHE_MAX_SIZE=1000

# ========================================
# Google Maps Configuration (Optional)
# ========================================
GOOGLE_MAPS_API_KEY=
