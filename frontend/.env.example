# ========================================
# PitMind Frontend Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to git

# ========================================
# Firebase Configuration (Public - Safe to expose in frontend)
# ========================================
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ========================================
# API Configuration
# ========================================
# Backend API URL (use HTTPS in production)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL (optional - auto-detected if not set)
# VITE_WS_URL=ws://localhost:8000/api/v1/stream/telemetry

# ========================================
# Development Only (NEVER set these in production!)
# ========================================
# VITE_BYPASS_AUTH=false

# ========================================
# IMPORTANT SECURITY NOTES:
# ========================================
# 1. Firebase API keys in frontend are PUBLIC and safe to expose
# 2. However, you MUST configure Firebase Security Rules properly
# 3. You MUST restrict the API key to your domain in Google Cloud Console
# 4. Never use VITE_BYPASS_AUTH in production
# 5. Always use HTTPS (https://) for VITE_API_BASE_URL in production
# 6. This file is a template - DO NOT commit your actual .env file
